# Copy to .env.local. Local Docker Postgres (pnpm db:up):
DATABASE_URL=postgres://lineup:lineup@localhost:5432/lineup
# Production (Neon), from the Neon console, pooled connection:
# DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/lineup?sslmode=require

# Neon Auth (Neon console → Auth): sign-in with emailed codes.
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
# At least 32 random characters, e.g. `openssl rand -base64 32`.
NEON_AUTH_COOKIE_SECRET=
